{
  "name": "future-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "NODE_ENV=development node --watch server/index.js",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/*.test.js && vitest run",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.js",
    "postinstall": "node scripts/patch-spelling-deps.mjs",
    "test:rules": "node --test tests/supabase.test.js",
    "test:e2e": "playwright test",
    "check": "npm test && npm run test:rules && npm run build && npm run test:e2e",
    "check:release": "node scripts/check-release.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test:e2e:full": "node scripts/run-e2e.mjs",
    "migrate:users": "node scripts/migrate-firebase-users.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.87",
    "@sentry/node": "^11.12.0",
    "@sentry/vue": "^11.12.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tiptap/extension-highlight": "^3.32.3",
    "@tiptap/extension-placeholder": "^3.32.3",
    "@tiptap/extension-task-item": "^3.32.3",
    "@tiptap/extension-task-list": "^3.32.3",
    "@tiptap/pm": "^3.32.3",
    "@tiptap/starter-kit": "^3.32.3",
    "@tiptap/vue-3": "^3.32.3",
    "dictionary-pt": "^4.0.0",
    "docx": "^9.5.1",
    "dompurify": "^3.4.17",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "gsap": "^3.13.0",
    "hunspell-asm": "^4.0.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.3",
    "pdfjs-dist": "^6.5.438",
    "pinia": "^2.3.1",
    "stripe": "^23.1.0",
    "three": "^0.180.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "vuetify": "^3.8.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^9.1.2",
    "jsdom": "^31.0.0",
    "sass": "^1.85.1",
    "supabase": "^3.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "picomatch": "file:./vendor/picomatch"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "qs": "^6.17.1",
    "minimatch": "^11.0.1",
    "glob": "^14.0.3",
    "hunspell-asm": {
      "nanoid": "^3.3.18"
    },
    "emscripten-wasm-loader": {
      "nanoid": "^3.3.18"
    },
    "picomatch": "$picomatch"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
