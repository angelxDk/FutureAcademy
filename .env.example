# Backend API proxy (server/index.js)
PORT=8787
HOST=127.0.0.1

# OpenAI — servidor (backend/communities)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# Spotify (use client credentials OR a static access token)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# SPOTIFY_ACCESS_TOKEN=optional_static_access_token

# ExchangeRate-API
EXCHANGERATE_API_KEY=your_exchangerate_api_key

# Supabase Free — frontend uses only the publishable/anon key.
VITE_SUPABASE_URL=https://your_project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# IA local gratuita (opcional, requer Ollama no computador do backend)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Backend only. Never expose the service role key using a VITE_ prefix.
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_or_service_role_key
ENABLE_PAID_AI=false

# Public contact and optional error monitoring (diagnostics are filtered).
VITE_SUPPORT_EMAIL=angelycarodrigues11@gmail.com
# VITE_SENTRY_DSN=
# SENTRY_DSN=

# Freemium billing. Configure a recurring Stripe price and the webhook before enabling.
# APP_URL=https://your-domain.example
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
